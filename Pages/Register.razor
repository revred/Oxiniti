@page "/register"
@inject NavigationManager Nav
@inject IMakerClient MakerClient
@inject LocalizationService Loc

<div class="login-container">
    <div class="login-form">
        <h2>@Loc.T("register.title", "Create Account ✨")</h2>
        <p class="subtitle">@Loc.T("register.subtitle", "Join us today. It takes only a few steps to get started!")</p>

        <div class="form-group">
            <label>@Loc.T("register.email", "Email")</label>
            <input @bind="email" type="email" placeholder="@Loc.T("register.email.placeholder", "Example@email.com")" />
        </div>

        <div class="form-group">
            <label>@Loc.T("register.password", "Password")</label>
            <input @bind="password" type="password" placeholder="@Loc.T("register.password.placeholder", "at least 8 characters")" />
        </div>

        <div class="form-group">
            <label>@Loc.T("register.confirmpassword", "Confirm Password")</label>
            <input @bind="confirmPassword" type="password" placeholder="@Loc.T("register.confirmpassword.placeholder", "repeat your password")" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error-message">@errorMessage</p>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <p class="success-message">@successMessage</p>
        }

        <button class="primary-button" @onclick="OnRegister" disabled="@isBusy">
            @(isBusy ? Loc.T("register.registering", "Registering...") : Loc.T("register.signup", "Sign up"))
        </button>

        <div class="separator">
            <span>@Loc.T("register.or", "Or")</span>
        </div>
        <div class="signup-link">
            @Loc.T("register.hasaccount", "Already have an account?") <a href="/login">@Loc.T("register.signin", "Sign in")</a>
        </div>
    </div>

    <div class="login-image">
        <picture>
            <source type="image/avif" srcset="images/login.avif" />
            <source type="image/webp" srcset="images/login.webp" />
            <img src="images/login.jpg" width="1080" height="1919" decoding="async" alt="Register illustration" />
        </picture>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isBusy = false;

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    private async Task OnRegister()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = Loc.T("register.error.fillfields", "Please fill in all fields.");
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = Loc.T("register.error.mismatch", "Passwords do not match.");
            return;
        }

        if (!IsPasswordStrong(password))
        {
            errorMessage = Loc.T("register.error.weak", "Password must be at least 8 characters long and contain uppercase, lowercase, digit, and special character.");
            return;
        }

        isBusy = true;
        try
        {
            var result = await MakerClient.RegisterAsync(body: new RegisterUserRequest
            {
                Email = email,
                Password = password
            });

            if (result.IsSuccess)
            {
                Nav.NavigateTo("/email-verification", forceLoad: false);
            }
            else
            {
                errorMessage = result?.Message ?? Loc.T("register.error.failed", "Registration failed. Please try again.");
                Console.WriteLine($"[Register] Failed: {errorMessage}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"[Register] Exception: {ex}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private bool IsPasswordStrong(string password)
    {
        // At least 8 characters, 1 uppercase, 1 lowercase, 1 number, 1 special character
        var regex = new System.Text.RegularExpressions.Regex(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&]).{8,}$");
        return regex.IsMatch(password);
    }
}
