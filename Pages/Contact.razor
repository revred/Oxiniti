@page "/contact"
@page "/{Locale}/contact"
@inject LocalizationService Loc
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (_notFound)
{
    <NotFoundContent />
    return;
}

<PageTitle>@Loc.T("contact.pagetitle", "Contact Oxyniti")</PageTitle>
<HeadContent>
    <LocaleHead Slug="contact" />
    <meta name="description" content="@Loc.T("contact.meta", "Get in touch with Oxyniti — call, WhatsApp, or book a free on-pond demo.")" />
</HeadContent>

<div class="contact-page">
    <span class="kicker">@Loc.T("contact.kicker", "Get in touch")</span>
    <h1 class="section-title">@Loc.T("contact.h1", "Contact Us")</h1>
    <p class="section-lead">
        @Loc.T("contact.lead", "Have a question about nano-bubble aeration for your pond, RAS or biofloc system? Reach us directly, or book a free on-pond demo.")
    </p>

    <div class="contact-rails">
        <a class="rail rail-link" href="@SiteContact.PhoneLink">
            <span class="ico">&#128222;</span>
            <span>
                <b>@Loc.T("con.r1b", "Call us")</b>
                <span class="rail-sub">@Loc.T("con.r1s", "Tap to call") &middot; @SiteContact.PhoneDisplay</span>
            </span>
        </a>
        <a class="rail rail-link" href="@SiteContact.WhatsAppLink("Hi, I'd like to know more about Oxyniti.")"
           target="_blank" rel="noopener">
            <span class="ico wa-ico"><i class="bi bi-whatsapp"></i></span>
            <span>
                <b>@Loc.T("con.r2b", "Chat on WhatsApp")</b>
                <span class="rail-sub">@Loc.T("con.r2s", "Fastest way to reach us — usually a reply in minutes")</span>
            </span>
        </a>
        <div class="rail">
            <span class="ico">&#128205;</span>
            <span>
                <b>@Loc.T("con.r3b", "Serving South India")</b>
                <span class="rail-sub">@Loc.T("con.r3s", "Currently piloting across South India")</span>
            </span>
        </div>
    </div>

    <div class="demo-cta">
        <div>
            <b>@Loc.T("contact.demo.h", "Experience the results before you invest.")</b>
            <span>@Loc.T("contact.demo.p", "We'll install a unit on your pond, measure dissolved oxygen before and after, and show you the difference the same day.")</span>
        </div>
        <a class="btn-warm" href="/#free-demo">@Loc.T("contact.demo.link", "Book a free demo →")</a>
    </div>
</div>

@code {
    [Parameter] public string? Locale { get; set; }

    private bool _notFound;

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var resolved = LocalizationService.ResolveRouteLocale(Locale, "contact");

        switch (resolved.Outcome)
        {
            case LocalizationService.RouteLocaleOutcome.NotFound:
                _notFound = true;
                return;
            case LocalizationService.RouteLocaleOutcome.Redirect:
                Nav.NavigateTo(resolved.RedirectPath!, replace: true);
                return;
            case LocalizationService.RouteLocaleOutcome.RenderLocale:
                await Loc.SetLanguageAsync(resolved.Locale!);
                await SyncHtmlLangAsync(resolved.Locale!);
                break;
        }
    }

    private async Task SyncHtmlLangAsync(string code)
    {
        try
        {
            await JS.InvokeVoidAsync("oxynitiI18n.setHtmlLang", code);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Contact] Error syncing html lang attribute: {ex}");
        }
    }
}
