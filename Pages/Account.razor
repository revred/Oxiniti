@page "/account"
@using System.IdentityModel.Tokens.Jwt
@using System.Text.Json
@using Oxyniti.Services
@inject IJSRuntime JSRuntime
@inject IAuthenticationService AuthenticationService
@inject IDemoAccountService DemoAccountService
@inject CartService CartService
@inject NavigationManager Nav
@inject LocalizationService Loc
@inject AuthReadyGate AuthReady

<PageTitle>Your Account - Oxyniti</PageTitle>

<div class="account-page">
@if (!isReady)
{
    <div class="d-flex align-items-center gap-2 p-4">
        <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
        <span>@Loc.T("account.loading", "Loading account…")</span>
    </div>
}
else
{
    <div class="account-shell">
        <aside class="account-sidebar">
            <nav class="sidebar-nav">
                <span class="sidebar-item active">
                    <i class="bi bi-person-circle"></i> @Loc.T("account.nav.profile", "Profile")
                </span>
                @* Same icons and order as the header user menu (Layout/MainLayout.razor). *@
                @if (AuthenticationService.IsMakerAIUser == true)
                {
                    <a class="sidebar-item" href="/orders">
                        <i class="bi bi-receipt"></i> @Loc.T("account.nav.orders", "My Orders")
                    </a>
                    <a class="sidebar-item" href="/my-demos">
                        <i class="bi bi-geo-alt"></i> @Loc.T("account.nav.demos", "My Demos")
                    </a>
                }
                <button type="button" class="sidebar-item sidebar-logout" @onclick="HandleLogout">
                    <i class="bi bi-box-arrow-left"></i> @Loc.T("account.nav.logout", "Logout")
                </button>
            </nav>
        </aside>

        <div class="account-main">
            <div class="account-header">
                <div>
                    <h2 class="mb-1">@Loc.T("account.title", "My Account")</h2>
                    <p class="text-muted mb-0">@Loc.T("account.subtitle", "Manage your account details")</p>
                </div>
                @* "Verified" badge hidden with the WhatsApp-passcode login (see Login.razor):
                   it only showed after a passcode login, which confirmed the phone number.
                @if (isPasscodeVerified)
                {
                    <div class="verified-badge">
                        <span class="verified-icon"><i class="bi bi-shield-fill-check"></i></span>
                        <span class="verified-copy">
                            <strong>@Loc.T("account.verified", "Your account is verified")</strong>
                            <small>@Loc.T("account.verified.sub", "You can update your details anytime.")</small>
                        </span>
                    </div>
                }
                *@
            </div>

            <div class="account-card">
                <div class="card-heading">
                    <span class="card-icon"><i class="bi bi-person-fill"></i></span>
                    <div>
                        <h5 class="mb-0">@Loc.T("account.profile.info", "Profile Information")</h5>
                        <p class="text-muted small mb-0">@Loc.T("account.profile.info.sub", "Update your personal details used for demos and communication.")</p>
                    </div>
                </div>

                <EditForm Model="profileVm" OnValidSubmit="SaveProfileAsync">
                    <div class="profile-grid">
                        <div class="field">
                            <label>@Loc.T("account.field.name", "Full Name") <span class="req">*</span></label>
                            <InputText id="profile-name" class="acc-input" @bind-Value="profileVm.Name" />
                        </div>
                        <div class="field">
                            <label>@Loc.T("account.field.whatsapp", "WhatsApp Number") <span class="req">*</span></label>
                            <div class="input-with-icon">
                                <InputText id="profile-whatsapp" class="acc-input" type="tel" inputmode="tel" autocomplete="tel" @bind-Value="profileVm.Phone" placeholder="@Loc.T("account.field.whatsapp.ph", "e.g. 98765 43210")" />
                                <i class="bi bi-whatsapp"></i>
                            </div>
                            <small class="field-hint">@Loc.T("account.field.whatsapp.hint2", "We'll contact you about demos on this number.")</small>
                        </div>
                        <div class="field">
                            <label>@Loc.T("account.field.email", "Email")</label>
                            <input class="acc-input" value="@profileVm.Email" disabled />
                            <small class="field-hint">@Loc.T("account.field.email.hint", "Linked to your account and cannot be changed here.")</small>
                        </div>
                        <div class="field">
                            <label>@Loc.T("account.field.altphone", "Alternate Phone (Optional)")</label>
                            <InputText class="acc-input" @bind-Value="profileVm.AlternatePhone" placeholder="@Loc.T("account.field.altphone.ph", "Enter alternate number")" />
                        </div>
                        <div class="field">
                            <label>@Loc.T("account.field.place", "Village / Town") <span class="req">*</span></label>
                            <InputText id="profile-place" class="acc-input" @bind-Value="profileVm.Place" />
                        </div>
                        <div class="field">
                            <label>@Loc.T("account.field.state", "State") <span class="req">*</span></label>
                            <InputText id="profile-state" class="acc-input" @bind-Value="profileVm.State" />
                        </div>
                        <div class="field">
                            <label>@Loc.T("account.field.pondlocation", "Pond Location") <span class="req">*</span></label>
                            <InputText id="profile-pond-location" class="acc-input" @bind-Value="profileVm.PondLocation" placeholder="@Loc.T("account.field.pondlocation.ph", "e.g. Near Lalgudi Main Road")" />
                        </div>
                        <div class="field">
                            <label>@Loc.T("account.field.size", "Pond Size") <span class="req">*</span></label>
                            <InputSelect class="acc-input" @bind-Value="profileVm.Size">
                                <option>@Loc.T("o.size1", "Under ½ acre")</option>
                                <option>@Loc.T("o.size2", "½ – 1 acre")</option>
                                <option>@Loc.T("o.size3", "1 – 3 acres")</option>
                                <option>@Loc.T("o.size4", "3+ acres / multiple ponds")</option>
                            </InputSelect>
                        </div>
                        <div class="field full">
                            <label>@Loc.T("account.field.species", "What do you farm?") <span class="req">*</span></label>
                            <InputSelect class="acc-input" @bind-Value="profileVm.Species">
                                <option>@Loc.T("o.sp1", "Tilapia / GIFT")</option>
                                <option>@Loc.T("o.sp2", "Murrel (Viral meen)")</option>
                                <option>@Loc.T("o.sp3", "Pangasius")</option>
                                <option>@Loc.T("o.sp4", "Freshwater prawn")</option>
                                <option>@Loc.T("o.sp5", "Carp polyculture")</option>
                                <option>@Loc.T("o.sp6", "Biofloc / RAS")</option>
                                <option>@Loc.T("o.sp7", "Other")</option>
                            </InputSelect>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(profileStatusMessage))
                    {
                        <p class="profile-status @(profileStatusIsError ? "is-error" : "is-success")" data-testid="profile-status">@profileStatusMessage</p>
                    }

                    <button type="submit" class="btn-save" disabled="@profileSaving">
                        @if (profileSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save2"></i>
                        }
                        @Loc.T("account.save", "Save Changes")
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
}
</div>

@code {
    // Until the Maker API can store a profile, Save keeps it on this device
    // (one entry per login email) so the form opens filled in next time.
    private const string ProfileStoragePrefix = "oxyniti_profile:";

    private bool isReady;
    private ProfileEditorVm profileVm = new();
    private bool profileSaving;
    private string? profileStatusMessage;
    private bool profileStatusIsError;

    protected override async Task OnInitializedAsync()
    {
        Loc.OnChange += StateHasChanged;

        // Wait for MainLayout's token rehydration from localStorage before
        // trusting IsAuthenticated -- on a hard refresh this page's
        // OnInitializedAsync can otherwise run first and see the
        // freshly-constructed "false" default, bouncing a signed-in user to
        // /login.
        await AuthReady.Ready;

        if (!AuthenticationService.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var email = GetClaimFromAccessToken(AuthenticationService.AccessToken, "email", JwtRegisteredClaimNames.Email) ?? string.Empty;
        profileVm = await LoadSavedProfileAsync(email) ?? new ProfileEditorVm();
        profileVm.Email = email;
        if (string.IsNullOrWhiteSpace(profileVm.Phone))
            profileVm.Phone = GetClaimFromAccessToken(AuthenticationService.AccessToken, "phone_number", "phone") ?? string.Empty;

        isReady = true;
    }

    private async Task SaveProfileAsync()
    {
        profileStatusMessage = null;
        if (new[] { profileVm.Name, profileVm.Phone, profileVm.Place, profileVm.State, profileVm.PondLocation }.Any(string.IsNullOrWhiteSpace))
        {
            profileStatusMessage = Loc.T("account.profile.required", "Please fill in every box marked *.");
            profileStatusIsError = true;
            return;
        }

        profileSaving = true;
        try
        {
            var savedHere = await SaveProfileLocallyAsync();
            var result = await DemoAccountService.UpdateProfileAsync(new UpdateDemoProfileRequest
            {
                Name = profileVm.Name,
                Phone = profileVm.Phone,
                Email = profileVm.Email,
                AlternatePhone = profileVm.AlternatePhone,
                Place = profileVm.Place,
                State = profileVm.State,
                PondLocation = profileVm.PondLocation,
                Size = profileVm.Size,
                Species = profileVm.Species
            });
            if (result.IsSuccess)
            {
                profileStatusMessage = result.Message;
                profileStatusIsError = false;
            }
            else
            {
                profileStatusMessage = savedHere
                    ? Loc.T("account.profile.savedlocal", "Saved. Your details will be filled in next time you open this page on this device.")
                    : result.Message;
                profileStatusIsError = !savedHere;
            }
        }
        finally
        {
            profileSaving = false;
        }
    }

    private async Task HandleLogout()
    {
        try
        {
            await AuthenticationService.LogoutAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Account] Error during logout: {ex}");
        }

        try
        {
            await CartService.ClearCart();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Account] Error clearing cart: {ex}");
        }

        Nav.NavigateTo("/");
    }

    private async Task<ProfileEditorVm?> LoadSavedProfileAsync(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return null;
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", ProfileStoragePrefix + email.ToLowerInvariant());
            return string.IsNullOrEmpty(json) ? null : JsonSerializer.Deserialize<ProfileEditorVm>(json);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Account] Could not read the saved profile: {ex.Message}");
            return null;
        }
    }

    private async Task<bool> SaveProfileLocallyAsync()
    {
        if (string.IsNullOrWhiteSpace(profileVm.Email)) return false;
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", ProfileStoragePrefix + profileVm.Email.ToLowerInvariant(), JsonSerializer.Serialize(profileVm));
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Account] Could not save the profile on this device: {ex.Message}");
            return false;
        }
    }

    private static string? GetClaimFromAccessToken(string? accessToken, params string[] claimTypes)
    {
        if (string.IsNullOrWhiteSpace(accessToken)) return null;
        var handler = new JwtSecurityTokenHandler();
        if (!handler.CanReadToken(accessToken)) return null;
        var jwt = handler.ReadJwtToken(accessToken);
        return jwt.Claims.FirstOrDefault(c => claimTypes.Contains(c.Type))?.Value;
    }

    private class ProfileEditorVm
    {
        public string Name { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string AlternatePhone { get; set; } = string.Empty;
        public string Place { get; set; } = string.Empty;
        public string State { get; set; } = string.Empty;
        public string PondLocation { get; set; } = string.Empty;
        public string Size { get; set; } = "½ – 1 acre";
        public string Species { get; set; } = "Tilapia / GIFT";
    }
}
