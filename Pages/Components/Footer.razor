@inject BusinessInfoService Info
@inject LocalizationService Loc

<footer class="site-footer">
    <div class="container">
        <div class="footer-content">
            <div class="footer-brand">
                @if (Info.Asset != null)
                {
                    <img src="@Info.Asset.Url"
                         class="logo"
                         style="width:100px;" />
                }
                <div class="brand-text">
                    <h3>@Info.ApplicationName</h3>
                    <p class="tagline">@Info.TagLine</p>
                </div>

                <p class="foot-desc">
                    @Loc.T("foot.desc", "Nano-bubble aeration engineered for South Indian aquaculture. Prove it on your pond before you spend a rupee.")
                </p>

                <div>
                    @((MarkupString)Info.SocialMediaLinks)
                </div>
            </div>

            <div class="footer-links">
                <div class="footer-section">
                    <h4>@Loc.T("foot.explore", "Explore")</h4>
                    <ul>
                        <li><a href="/#technology">@Loc.T("nav.tech", "Technology")</a></li>
                        <li><a href="/#sky-view">@Loc.T("nav.sky", "Sky View")</a></li>
                        <li><a href="/#results">@Loc.T("nav.results", "Results")</a></li>
                        <li><a href="/#field-footage">@Loc.T("nav.footage", "Field Footage")</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h4>@Loc.T("foot.farmers", "Farmers")</h4>
                    <ul>
                        <li><a href="/#profit-calculator">@Loc.T("fl.roi", "Profit calculator")</a></li>
                        <li><a href="/#free-demo">@Loc.T("fl.demo", "Free demo")</a></li>
                        <li><a href="/#why-oxygen">@Loc.T("nav.why", "Why Oxygen")</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <span class="copyright">@Info.CopyRightNotice</span>
            <span class="foot-made">@Loc.T("foot.made", "Made with 💙 for the farmers of South India")</span>
        </div>
    </div>
</footer>

@code {
    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }
}
