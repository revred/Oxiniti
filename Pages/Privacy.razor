@page "/privacy"
@implements IDisposable
@inject BusinessInfoService InfoService
@inject LocalizationService Loc

<PageTitle>Privacy Policy - Oxyniti</PageTitle>

<h2 class="section-title">@Loc.T("privacy.title", "Privacy Policy")</h2>

<div class="content-section">
    <p class="text-muted">
        <em>@string.Format(Loc.T("privacy.disclaimer", "Draft placeholder — pending final legal review and sign-off by {0} before this page is treated as binding."), InfoService.ApplicationName)</em>
    </p>

    <h5>@Loc.T("privacy.collect_title", "Information we collect")</h5>
    <p>
        @Loc.T("privacy.collect_body", "We collect information you provide directly (such as name, email, shipping address, and phone number during checkout or account registration) and basic usage data needed to operate the site (such as cart contents and order history).")
    </p>

    <h5>@Loc.T("privacy.use_title", "How we use it")</h5>
    <p>
        @Loc.T("privacy.use_body", "We use your information to process orders, manage your account, respond to enquiries submitted through the Contact and Quote forms, and improve the site. We do not sell your personal information to third parties.")
    </p>

    <h5>@Loc.T("privacy.payment_title", "Payment information")</h5>
    <p>
        @Loc.T("privacy.payment_body", "Payments are processed by Stripe. We do not store your full card details on our servers.")
    </p>

    <h5>@Loc.T("privacy.choices_title", "Your choices")</h5>
    <p>
        @((MarkupString)Loc.T("privacy.choices_body", "You can request access to, correction of, or deletion of your personal data by contacting us through the <a href=\"/contact\">Contact page</a>."))
    </p>
</div>

@code {
    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
        InfoService.OnChange += OnInfoChanged;
    }

    private void OnInfoChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
        InfoService.OnChange -= OnInfoChanged;
    }
}
