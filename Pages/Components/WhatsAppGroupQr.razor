@using Microsoft.JSInterop
@using Oxyniti
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="wa-group-qr">
    <div id="@_elementId" class="wa-group-qr-code" style="width:@(Size)px;height:@(Size)px;"></div>
    @if (!string.IsNullOrEmpty(Caption))
    {
        <span class="wa-group-qr-caption">@Caption</span>
    }
</div>

@code {
    [Parameter] public int Size { get; set; } = 120;
    [Parameter] public string? Caption { get; set; } = "Scan to join our WhatsApp group";

    private readonly string _elementId = $"wa-group-qr-{Guid.NewGuid():N}";
    private bool _rendered;
    private IJSObjectReference? _qrLoaderModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_rendered)
        {
            _rendered = true;

            try
            {
                _qrLoaderModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/qrLoader.js");

                // The footer (and this QR code) sits below the fold on
                // every page — wait until it scrolls into view before
                // pulling in qrcode-generator.
                await _qrLoaderModule.InvokeVoidAsync("whenVisible", _elementId);
                await _qrLoaderModule.InvokeVoidAsync("ensureLoaded");
                await JS.InvokeVoidAsync("oxynitiQr.render", _elementId, SiteContact.WhatsAppGroupLink);
            }
            catch (JSDisconnectedException)
            {
                // The circuit disconnected (e.g. the user navigated away)
                // before the footer ever scrolled into view.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_qrLoaderModule is null) return;

        try
        {
            await _qrLoaderModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Safe to ignore when Blazor circuit disconnects.
        }
    }
}
