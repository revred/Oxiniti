@page "/about"
@page "/{Locale}/about"
@implements IDisposable
@inject BusinessInfoService InfoService
@inject LocalizationService Loc
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (_notFound)
{
    <NotFoundContent />
    return;
}

<PageTitle>@Loc.T("about.pagetitle", "About Oxyniti | Nano-Bubble Aeration")</PageTitle>
<HeadContent>
    <LocaleHead Slug="about" />
    <meta name="description" content="@Loc.T("about.meta", "Oxyniti designs and manufactures nano-bubble aeration systems for aquaculture, wastewater treatment and hydroponics, with 100+ installations across India.")" />
</HeadContent>

<section class="cp-hero">
    <div class="cp-hero-inner">
        <span class="cp-kicker">@Loc.T("about.kicker", "About us")</span>
        <h1 class="cp-title">@Loc.T("about.title", "About") @InfoService.ApplicationName</h1>
        <p class="cp-lead">
            @Loc.T("about.lead", "We design and build nano-bubble oxygenation systems in India — engineered in stainless steel, sized to the site, and proven on working farms.")
        </p>
    </div>
</section>

<div class="cp-body">
    <ul class="cp-stats">
        <li class="cp-stat">
            <span class="cp-stat-n">100+</span>
            <span class="cp-stat-l">@Loc.T("about.stat1.l", "Installations across India")</span>
        </li>
        <li class="cp-stat">
            <span class="cp-stat-n">&lt;200 nm</span>
            <span class="cp-stat-l">@Loc.T("about.stat2.l", "Nano-bubble size")</span>
        </li>
        <li class="cp-stat">
            <span class="cp-stat-n">3</span>
            <span class="cp-stat-l">@Loc.T("about.stat3.l", "Sectors served")</span>
        </li>
    </ul>

    <div class="cp-section">
        <h2>@Loc.T("about.build.h", "What we build")</h2>
        <p>@Loc.T("about.p1", "Oxyniti designs and manufactures high-efficiency nanobubble generators for aquaculture, wastewater treatment, and hydroponics. Built with robust stainless-steel engineering, our systems deliver superior oxygen dissolution, low maintenance, and long-term reliability.")</p>
    </div>

    <div class="cp-callout">
        <h2>@Loc.T("about.reach.h", "Proven across India")</h2>
        <p>@Loc.T("about.p2", "With 100+ installations across India, we provide scalable, energy-efficient oxygenation solutions that enhance water quality and support sustainable operations.")</p>
    </div>

    <div class="cp-cta">
        <p>@Loc.T("about.cta", "Tell us about your pond or facility and we'll help size a system.")</p>
        <a class="cp-cta-btn" href="/contact">@Loc.T("about.cta.link", "Contact Oxyniti")<i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="cp-links-row">
        <a href="/technology"><i class="bi bi-lightning-charge"></i>@Loc.T("about.link.tech", "How the nano-bubble technology works")</a>
        <a href="/aquaculture-oxygenation"><i class="bi bi-water"></i>@Loc.T("about.link.aq", "Aquaculture oxygenation overview")</a>
        <a href="/products"><i class="bi bi-box-seam"></i>@Loc.T("about.link.products", "View products")</a>
    </div>
</div>

@code {
    [Parameter] public string? Locale { get; set; }

    private bool _notFound;

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
        InfoService.OnChange += OnInfoChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var resolved = LocalizationService.ResolveRouteLocale(Locale, "about");

        switch (resolved.Outcome)
        {
            case LocalizationService.RouteLocaleOutcome.NotFound:
                _notFound = true;
                return;
            case LocalizationService.RouteLocaleOutcome.Redirect:
                Nav.NavigateTo(resolved.RedirectPath!, replace: true);
                return;
            case LocalizationService.RouteLocaleOutcome.RenderLocale:
                await Loc.SetLanguageAsync(resolved.Locale!);
                await SyncHtmlLangAsync(resolved.Locale!);
                break;
        }
    }

    private async Task SyncHtmlLangAsync(string code)
    {
        try
        {
            await JS.InvokeVoidAsync("oxynitiI18n.setHtmlLang", code);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[About] Error syncing html lang attribute: {ex}");
        }
    }

    private void OnInfoChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
        InfoService.OnChange -= OnInfoChanged;
    }
}

