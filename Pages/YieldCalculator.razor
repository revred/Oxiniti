@page "/yield-calculator"
@inject IJSRuntime JS

@* The Tamil Nadu yield and profit calculator
   (https://github.com/vivian4fb/oxyniti-yield-calc), inside the site's own
   layout and footer. Its body is generated by scripts/sync-yield-calculator.sh
   into YieldCalculatorMarkup.g.cs, and wwwroot/js/yieldCalculator.js loads and
   starts its unchanged scripts on top of that markup. Blazor never re-renders
   the markup (it is a constant), so the calculator's own DOM updates stand. *@

<PageTitle>Yield &amp; profit calculator for Tamil Nadu fish &amp; shrimp ponds - Oxyniti</PageTitle>
<HeadContent>
    <meta name="description" content="Estimate the extra harvest from Oxyniti nano-bubble aeration for your pond, by species, district, stocking month and density, with a map of Tamil Nadu's aquaculture hotspots." />
</HeadContent>

<div id="yc-root" class="yc">
    @((MarkupString)YieldCalculatorMarkup.Html)
</div>

<Footer />

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await JS.InvokeAsync<IJSObjectReference>("import", "./js/yieldCalculator.js");
        }
        catch (JSException ex)
        {
            Console.WriteLine($"[YieldCalculator] Error loading the calculator: {ex.Message}");
        }
    }
}
