@inject LocalizationService Loc
@implements IDisposable

<section class="oxy-video-section" id="oxy-nano-video" aria-labelledby="oxy-video-title">

    <div class="oxy-video-inner">

        <div class="oxy-video-heading">

            <span class="oxy-video-kicker">
                @Loc.T("oxyNano.kicker", "OXY-NANO SERIES")
            </span>

            <h2 id="oxy-video-title">
                @Loc.T(
                    "oxyNano.title",
                    "See the OXY-Nano Series in action."
                )
            </h2>

            <p>
                @Loc.T(
                    "oxyNano.description",
                    "From low-oxygen ponds to bigger harvests: see how OXY-Nano nano-bubbles reach the whole pond floor, the 1.5, 3 and 5 HP models, and the yield gains farmers are seeing."
                )
            </p>

        </div>

        @*
            The product overview lives on YouTube rather than being streamed
            from the homepage -- same reasoning as the drone clip in
            SkyViewSection: no video download for visitors who scroll past.
        *@
        <a class="oxy-video-cta"
           href="@YouTubeUrl"
           target="_blank"
           rel="noopener noreferrer">
            <span class="oxy-yt-mark">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M21.6 7.2a2.5 2.5 0 0 0-1.75-1.77C18.28 5 12 5 12 5s-6.28 0-7.85.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.75 1.77C5.72 19 12 19 12 19s6.28 0 7.85-.43a2.5 2.5 0 0 0 1.75-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8z" />
                    <path class="oxy-yt-tri" d="M10.15 15.1V8.9L15.5 12z" />
                </svg>
            </span>
            <span>@Loc.T("sky.cta", "Watch on YouTube")</span>
            <svg class="oxy-cta-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M7 17 17 7M9 7h8v8" />
            </svg>
        </a>

    </div>

</section>


@code {
    /// <summary>The OXY-Nano Series product overview on the Oxyniti YouTube channel.</summary>
    private const string YouTubeUrl = "https://www.youtube.com/watch?v=wRUlzXs4LWs";

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }
}
