@page "/products"
@page "/{Locale}/products"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LocalizationService Loc

@if (_notFound)
{
    <NotFoundContent />
    return;
}

<PageTitle>Oxyniti Products | Nano-Bubble Aeration Systems</PageTitle>
<HeadContent>
    <LocaleHead Slug="products" />
    <meta name="description" content="Browse Oxyniti's nano-bubble aeration products for aquaculture ponds, RAS and biofloc systems." />
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "ProductGroup",
        "name": "OXY-Nano Series nano-bubble generator",
        "brand": { "@@type": "Brand", "name": "Oxyniti" },
        "variesBy": "https://schema.org/size",
        "hasVariant": [
            { "@@type": "Product", "name": "OXY-Nano-1.5", "sku": "OXY-NANO-1.5" },
            { "@@type": "Product", "name": "OXY-Nano-3", "sku": "OXY-NANO-3" },
            { "@@type": "Product", "name": "OXY-Nano-5", "sku": "OXY-NANO-5" }
        ]
    }
    </script>
</HeadContent>

<div class="container-fluid px-4 py-5">
    <ExploreProductRange @bind-SearchTerm="SearchTerm" />

    <DiscoverProductTypes />

    <HelpBanner />

    <InfoCards />

    <Footer/>
</div>

@code {
    [Parameter] public string? Locale { get; set; }

    private bool _notFound;
    private string? SearchTerm { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var resolved = LocalizationService.ResolveRouteLocale(Locale, "products");

        switch (resolved.Outcome)
        {
            case LocalizationService.RouteLocaleOutcome.NotFound:
                _notFound = true;
                return;
            case LocalizationService.RouteLocaleOutcome.Redirect:
                Nav.NavigateTo(resolved.RedirectPath!, replace: true);
                return;
            case LocalizationService.RouteLocaleOutcome.RenderLocale:
                await Loc.SetLanguageAsync(resolved.Locale!);
                await SyncHtmlLangAsync(resolved.Locale!);
                break;
        }
    }

    private async Task SyncHtmlLangAsync(string code)
    {
        try
        {
            await JS.InvokeVoidAsync("oxynitiI18n.setHtmlLang", code);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Products] Error syncing html lang attribute: {ex}");
        }
    }
}
