@inject BusinessInfoService InfoService
@inject LocalizationService Loc
<div class="why-choose-section">
    <h2 class="section-title">@Loc.T("benefits.h1", "Why Choose") @InfoService.ApplicationName</h2>

    <div class="features-container">
        <div class="features-list">
            <div class="feature-card">
                <div class="feature-left">
                    <h3 class="feature-title">@Loc.T("benefits.f1.title", "Superior Oxygen Transfer Efficiency")</h3>
                    <p class="feature-description">
                        @Loc.T("benefits.f1.desc", "Engineered to deliver stable nanobubbles with high dissolution rates, improving water quality faster than conventional aeration.")
                    </p>
                </div>
                <div class="feature-icon-img">
                    <picture>
                        <source type="image/webp" srcset="/images/efficiency.webp?v=2" />
                        <img src="/images/efficiency.png?v=2" width="80" height="80" loading="lazy" decoding="async" alt="@Loc.T("benefits.f1.alt", "Fast Setup Icon")" />
                    </picture>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-left">
                    <h3 class="feature-title">@Loc.T("benefits.f2.title", "Robust Stainless-Steel Construction")</h3>
                    <p class="feature-description">
                        @Loc.T("benefits.f2.desc", "Durable, corrosion-resistant design built for harsh aquaculture and wastewater environments, ensuring long service life.")
                    </p>
                </div>
                <div class="feature-icon-img">
                    <picture>
                        <source type="image/webp" srcset="/images/precision.webp?v=2" />
                        <img src="/images/precision.png?v=2" width="80" height="80" loading="lazy" decoding="async" alt="@Loc.T("benefits.f2.alt", "Precision Icon")" />
                    </picture>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-left">
                    <h3 class="feature-title">@Loc.T("benefits.f3.title", "Proven Field Performance")</h3>
                    <p class="feature-description">
                        @Loc.T("benefits.f3.desc", "100+ systems deployed across Andhra Pradesh and Karnataka with consistent results in farms, treatment plants, and research setups.")
                    </p>
                </div>
                <div class="feature-icon-img">
                    <picture>
                        <source type="image/webp" srcset="/images/performance.webp?v=2" />
                        <img src="/images/performance.png?v=2" width="80" height="80" loading="lazy" decoding="async" alt="@Loc.T("benefits.f3.alt", "Rugged Design Icon")" />
                    </picture>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-left">
                    <h3 class="feature-title">@Loc.T("benefits.f4.title", "Low Maintenance, High Reliability")</h3>
                    <p class="feature-description">
                        @Loc.T("benefits.f4.desc", "Efficient pump design, minimal clogging, and simplified servicing reduce downtime and operational costs.")
                    </p>
                </div>
                <div class="feature-icon-img">
                    <picture>
                        <source type="image/webp" srcset="/images/maintenance.webp?v=2" />
                        <img src="/images/maintenance.png?v=2" width="80" height="80" loading="lazy" decoding="async" alt="@Loc.T("benefits.f4.alt", "Custom Icon")" />
                    </picture>
                </div>
            </div>
        </div>

        <div class="product-showcase">
            <picture>
                <source type="image/avif" srcset="/images/nanobubble.avif" />
                <source type="image/webp" srcset="/images/nanobubble.webp" />
                <img src="/images/nanobubble.png?v=1" width="626" height="417" loading="lazy" decoding="async" alt="@Loc.T("benefits.showcaseAlt", "Nano bubble")" />
            </picture>
        </div>
    </div>

    <div class="actions">
        <a href="products" class="btn btn-primary">@Loc.T("benefits.cta1", "Explore Our Products")</a>
        <a href="contact" class="btn btn-secondary">@Loc.T("benefits.cta2", "Request a Custom Solution")</a>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }
}
