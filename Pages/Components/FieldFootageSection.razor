@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject LocalizationService Loc

<div class="field-footage-section" id="use-cases">
    <span class="kicker">@Loc.T("gal.kicker", "Use cases")</span>
    <h2 class="section-title">@Loc.T("gal.h2", "No studio. No CGI. Just working ponds.")</h2>
    <p class="section-lead">@Loc.T("gal.p", "Real footage and photos from a working farm during a live trial.")</p>

    <div class="footage-grid">
        <div class="footage-card video-card">
            <video @ref="_videoElement" muted loop playsinline poster="/images/plume-poster.jpg">
                <source data-src="/videos/plume-portrait.webm" type="video/webm" />
                <source data-src="/videos/plume-portrait.mp4" type="video/mp4" />
            </video>
            <div class="caption">@Loc.T("ff.cap1", "The nano-plume — oxygen dissolving in real time")</div>
        </div>
        <div class="footage-photos">
            <div class="footage-card photo-card">
                <img src="/images/unit-pondside.jpg" alt="Two Oxyniti units installed beside a fish pond" loading="lazy" />
                <div class="caption">@Loc.T("ff.cap2", "On-site install — pond edge, ready to run")</div>
            </div>
            <div class="footage-card photo-card">
                <img src="/images/unit-fishfarm.jpg" alt="Oxyniti units running at a family fish farm" loading="lazy" />
                <div class="caption">@Loc.T("ff.cap3", "Family Fish Farm — live trial in progress")</div>
            </div>
        </div>
    </div>
</div>

@code {
    private ElementReference _videoElement;
    private IJSObjectReference? _videoModule;
    private IJSObjectReference? _videoController;

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _videoModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/lazyBackgroundVideo.js");

            _videoController = await _videoModule.InvokeAsync<IJSObjectReference>(
                "init",
                _videoElement,
                new { eager = false });
        }
        catch (JSException)
        {
            // Prevent page from breaking if JS is unavailable.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Loc.OnChange -= StateHasChanged;

        try
        {
            if (_videoController is not null)
            {
                await _videoController.InvokeVoidAsync("dispose");
                await _videoController.DisposeAsync();
            }

            if (_videoModule is not null)
            {
                await _videoModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Safe to ignore when Blazor circuit disconnects.
        }
    }
}
