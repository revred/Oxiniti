@inject LocalizationService Loc

@* A complete “revolution” section with banner + info row *@
<div class="revolution-banner d-flex mb-5 mt-5">
    <!-- Left gradient + text -->
    <div class="banner-text p-5 text-white">
        <h3 class="display-6">@Loc.T("revolution.h1", "A Revolution in Modular Workholding")</h3>
        <p>
            @Loc.T("revolution.p1", "Modular. Repeatable. Lightning-Fast Setup. The Oxyniti Zero Point system eliminates downtime and boosts productivity.")
        </p>
        <button class="btn btn-outline-light btn-lg">
            @Loc.T("revolution.cta1", "Learn How It Works →")
        </button>
    </div>

    <!-- Right full-height image -->
    <div class="banner-image">
        <img src="images/nano-bubble.jpg"
             alt="@Loc.T("revolution.imgAlt", "Modular workholding")" />
    </div>
</div>

<div class="revolution-info row mb-5">
    <div class="col-md-6 mb-4">
        <h5>@Loc.T("revolution.i1.title", "Shipping & Returns")</h5>
        <p>
            @Loc.T("revolution.i1.desc", "Unexpected shapes with smart details, functionality, a new luxury feel with a contemporary price point.")
        </p>
    </div>
    <div class="col-md-6 mb-4">
        <h5>@Loc.T("revolution.i2.title", "Hassle-Free Exchanges")</h5>
        <p>
            @Loc.T("revolution.i2.desc", "Exchanges are free. Try from the comfort of your home. We will collect from your home, work or an alternative address.")
        </p>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }
}
