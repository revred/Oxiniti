@implements IDisposable
@inject LocalizationService Loc

@* Invitation to the yield calculator: a small card that slides in once the
   visitor has scrolled halfway down a page. Markup only -- it starts hidden,
   and wwwroot/js/yieldPromo.js decides when to open it (back again a minute
   after every close, until the visitor goes to the calculator), so
   it works the same on the prerendered marketing pages, which have no
   Blazor runtime, as on the app routes. The script drives it through
   data-state, an attribute Blazor never renders, so a re-render (a language
   change) can't snap it shut. *@

<aside id="yield-promo"
       class="yield-promo"
       role="dialog"
       aria-modal="false"
       aria-labelledby="yield-promo-title"
       aria-hidden="true">

    <button type="button"
            class="yp-close"
            data-yp-dismiss
            aria-label="@Loc.T("promo.close", "Close")">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>

    <div class="yp-body">
        <p class="yp-eyebrow">
            <span class="yp-dot" aria-hidden="true"></span>
            @Loc.T("promo.eyebrow", "Free pond estimate")
        </p>

        <h2 id="yield-promo-title" class="yp-title">
            @Loc.T("promo.title", "What could your pond really harvest?")
        </h2>

        <p class="yp-text">
            @Loc.T("promo.text", "Pick your district, species and stocking. See your expected harvest, and how much more OXY-Nano could add: up to +18% more saleable fish where oxygen runs short.")
        </p>

        <div class="yp-actions">
            <a class="yp-cta" href="/yield-calculator" data-yp-go>
                @Loc.T("promo.cta", "Calculate my harvest")
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>

            <button type="button" class="yp-later" data-yp-dismiss>
                @Loc.T("promo.later", "Not now")
            </button>
        </div>
    </div>

</aside>

@code {
    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }
}
