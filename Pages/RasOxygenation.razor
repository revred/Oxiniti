@page "/ras-oxygenation"
@page "/{Locale}/ras-oxygenation"
@inject LocalizationService Loc
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (_notFound)
{
    <NotFoundContent />
    return;
}

<PageTitle>@Loc.T("rasox.pagetitle", "Advanced Aquaculture Systems | Oxyniti")</PageTitle>
<HeadContent>
    <LocaleHead Slug="ras-oxygenation" />
    <meta name="description" content="@Loc.T("rasox.meta", "Nano-bubble oxygenation for advanced aquaculture systems — recirculating aquaculture (RAS) and biofloc — where maintaining dissolved oxygen at high stocking density is critical.")" />
</HeadContent>

<section class="cp-hero">
    <div class="cp-hero-inner">
        <span class="cp-kicker">@Loc.T("rasox.kicker", "Advanced aquaculture systems")</span>
        <h1 class="cp-title">@Loc.T("rasox.h1", "Oxygenation for Advanced Aquaculture Systems")</h1>
        <p class="cp-lead">
            @Loc.T("rasox.intro", "Advanced aquaculture systems — recirculating aquaculture systems (RAS) and biofloc — run at much higher stocking densities than open ponds, which makes dissolved oxygen a tighter operating constraint. Oxyniti's nano-bubble aeration is designed to support these higher-density systems alongside conventional pond farming.")
        </p>
    </div>
</section>

<div class="cp-body">
    <div class="cp-section">
        <h2>@Loc.T("rasox.why.h", "Why high-density systems need more from aeration")</h2>
        <p>@Loc.T("rasox.why.p", "Higher stocking density means more oxygen demand per unit of water, less margin for a dissolved-oxygen dip, and often less water volume to buffer against a shortfall than an equivalent open pond. Aeration that keeps oxygen suspended through the water column, rather than escaping quickly at the surface, matters more as density rises.")</p>
    </div>

    <div class="cp-callout">
        <h2>@Loc.T("rasox.how.h", "How Oxyniti fits into a RAS or biofloc setup")</h2>
        <p>@Loc.T("rasox.how.p", "The same nano-shear aeration technology used across our pond installations applies to tanks and biofloc systems: it draws water, generates sub-200nm bubbles, and keeps oxygen in suspension rather than releasing it immediately at the surface. Because every RAS and biofloc setup differs in flow, biomass and target species, we size each installation individually rather than quoting a single fixed configuration.")</p>
    </div>

    <div class="cp-cta">
        <p>@Loc.T("rasox.cta", "Tell us about your system and we'll help size a solution.")</p>
        <a class="cp-cta-btn" href="/contact">@Loc.T("rasox.cta.link", "Contact Oxyniti")<i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="cp-links-row">
        <a href="/technology"><i class="bi bi-lightning-charge"></i>@Loc.T("rasox.link.tech", "How the nano-bubble technology works")</a>
        <a href="/aquaculture-oxygenation"><i class="bi bi-water"></i>@Loc.T("rasox.link.aq", "Aquaculture oxygenation overview")</a>
    </div>
</div>

@code {
    [Parameter] public string? Locale { get; set; }

    private bool _notFound;

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var resolved = LocalizationService.ResolveRouteLocale(Locale, "ras-oxygenation");

        switch (resolved.Outcome)
        {
            case LocalizationService.RouteLocaleOutcome.NotFound:
                _notFound = true;
                return;
            case LocalizationService.RouteLocaleOutcome.Redirect:
                Nav.NavigateTo(resolved.RedirectPath!, replace: true);
                return;
            case LocalizationService.RouteLocaleOutcome.RenderLocale:
                await Loc.SetLanguageAsync(resolved.Locale!);
                await SyncHtmlLangAsync(resolved.Locale!);
                break;
        }
    }

    private async Task SyncHtmlLangAsync(string code)
    {
        try
        {
            await JS.InvokeVoidAsync("oxynitiI18n.setHtmlLang", code);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RasOxygenation] Error syncing html lang attribute: {ex}");
        }
    }
}
