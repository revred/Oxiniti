@inject NavigationManager Nav

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <HeadContent>
            <link rel="canonical" href="@CanonicalUrl" />
        </HeadContent>
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>

    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <NotFoundContent />
        </LayoutView>
    </NotFound>
</Router>

@code {
    // Self-referencing canonical, stripped of query string, so it stays
    // correct across every route (including ?scrollTo=... deep links)
    // without needing a canonical tag hand-maintained on each page.
    private string CanonicalUrl => new Uri(Nav.Uri).GetLeftPart(UriPartial.Path);
}
