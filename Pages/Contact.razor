@page "/contact"
@inject LocalizationService Loc

<h2 class="section-title">@Loc.T("contact.title", "Contact Us")</h2>

<div class="content-section contact-form-container">
    <EditForm Model="@contactModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="name">@Loc.T("contact.name", "Name")</label>
            <InputText id="name" class="form-control" @bind-Value="contactModel.Name" />
        </div>

        <div class="form-group">
            <label for="email">@Loc.T("contact.email", "Email")</label>
            <InputText id="email" type="email" class="form-control" @bind-Value="contactModel.Email" />
        </div>

        <div class="form-group">
            <label for="message">@Loc.T("contact.message", "Message")</label>
            <InputTextArea id="message" class="form-control" rows="5" @bind-Value="contactModel.Message" />
        </div>

        <button type="submit" class="btn btn-primary">@Loc.T("contact.send", "Send Message")</button>
    </EditForm>
</div>

@code {
    private ContactModel contactModel = new();

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    private void HandleValidSubmit()
    {
        // TODO: wire up email or API call
        Console.WriteLine($"Contact form submitted by {contactModel.Name}");
        contactModel = new(); // reset form
    }

    public class ContactModel
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Message { get; set; } = "";
    }
}
