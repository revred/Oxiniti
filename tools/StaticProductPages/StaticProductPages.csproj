<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time static site generator for issue #65: product pages ship no
    crawlable content because /product/{Slug} is Blazor-WASM-only (nothing in
    the HTML until the runtime boots and calls MakerClient). This tool runs
    after `dotnet publish`, pulls the live catalogue over the same
    Maker.RampEdge client the app uses, and writes a real
    product/{slug}/index.html per product straight into the publish output,
    plus the matching <url> entries into the published sitemap.xml. Azure
    Static Web Apps serves a matching static file before it ever considers
    navigationFallback, so these are served as-is; when the Blazor runtime
    then boots or the visitor navigates client-side, ProductDetails.razor
    mounts into the same #app root and replaces the static markup with the
    live, interactive page (same pattern index.html already uses for the
    homepage's crawlable shell).

    Deliberately not part of Oxyniti.sln / Oxyniti.csproj: the workflow's
    `dotnet build`/`dotnet publish` (no explicit project) resolve to the one
    app project today, and folding a second publishable project into that
    would split publish output between two folders. Built and run as its own
    step instead.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Oxyniti.StaticProductPages</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Maker.RampEdgeV1" Version="1.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.8" />
    <PackageReference Include="Microsoft.JSInterop" Version="9.0.8" />
  </ItemGroup>

</Project>
