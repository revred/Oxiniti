<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Oxyniti</AssemblyName>
	<RootNamespace>Oxyniti</RootNamespace>
  </PropertyGroup>

  <!--
    First-visit payload (issue #35). The runtime is 2.7 MB over the wire before a
    single pixel renders, and the audience arrives on rural mobile connections.

    Note the SDK already sets PublishTrimmed=true and TrimMode=partial for Blazor
    WASM, so publish has always trimmed the framework. These are the levers on top
    of that. TrimMode=full is deliberately NOT set: it would start trimming the
    closed-source Maker.RampEdge assembly, whose reflection surface cannot be
    verified, and trim breakage here is silent (nulls and default-bound options,
    not build errors).
  -->
  <PropertyGroup>
    <!-- Feature switches. Each removes code the app never reaches. -->
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>

    <!--
      Drops the ICU dataset (issue #35, item 1). LocalizationService owns all
      user-facing translation and every date/money format in the app already
      uses an explicit format string ("dd/MM/yyyy", "N2") with either the
      invariant culture or invariant-safe format specifiers, so there is no
      culture-dependent formatting left for ICU to serve.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Source-generate the binder for the three BindConfiguration calls in
      Program.cs.

      Measured: this COSTS 1.6 KB rather than saving anything. It does not shrink
      System.Linq.Expressions, because that is rooted through System.Text.Json,
      which is in turn rooted by Maker.RampEdge calling JsonSerializer directly.
      RampEdge is untrimmed under TrimMode=partial, so no amount of first-party
      source generation removes either assembly.

      Kept anyway for correctness, not size: it replaces a RequiresUnreferencedCode
      reflection path, and is the prerequisite for ever taking TrimMode=full:
      under full trimming the reflection binder can silently bind nothing, which
      would break Stripe checkout at the API rather than at startup.
    -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".github\workflows\azure-static-web-apps-deploy.yml" />
  </ItemGroup>

  <!--
    tools/ holds the build-time static-product-pages generator (issue #65),
    its own standalone console project. It is not referenced by this project,
    but it sits inside this project's directory tree, so the SDK's default
    "**/*.cs" glob picks up both its Program.cs and (once built) its own
    obj/ generated sources, which collide on duplicate assembly
    attributes with this project's own. Exclude the whole tree.
  -->
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <Content Remove="tools\**\*" />
    <None Remove="tools\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Maker.RampEdgeV1" Version="1.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.8" PrivateAssets="all" />
    <!--
      Was pinned to 10.0.0-preview.5.25277.114 on a net9.0 app, which pulled a
      .NET 10 preview Microsoft.Extensions.Configuration.* set in alongside the
      9.0 runtime. Matched to the rest of the graph (issue #35, item 4).
    -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.8" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>
</Project>
