@page "/services/{Key}"
@implements IDisposable
@inject BusinessInfoService InfoService
@inject LocalizationService Loc

<h3>@Key</h3>

@if (Value != null)
{
    <div>
        @((MarkupString)Value)
    </div>
}
else
{
    <p>@Loc.T("services.notfound", "Service not found.")</p>
}

@code {
    [Parameter] public string Key { get; set; } = string.Empty;

    public string? Value { get; set; }

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
        InfoService.OnChange += OnInfoChanged;
    }

    protected override void OnParametersSet() => ResolveValue();

    private void ResolveValue()
        => Value = InfoService.Contents.TryGetValue(Key, out var val) ? val : null;

    // Contents arrive with the CMS payload, which is no longer awaited before the
    // first render — re-resolve the key once it lands.
    private void OnInfoChanged()
    {
        ResolveValue();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
        InfoService.OnChange -= OnInfoChanged;
    }
}
