@page "/orders"
@inject IMakerClient MakerClient
@inject NavigationManager Nav
@inject LocalizationService Loc
@inject IAuthenticationService AuthenticationService
@inject AuthReadyGate AuthReady

<div class="container-fluid px-4 py-5 orders-page">
<div class="orders-head">
    <h2 class="mb-1">@Loc.T("orders.title", "Your Orders")</h2>
    <p class="orders-sub mb-0">@Loc.T("orders.subtitle", "Track every order from placement to delivery.")</p>
</div>

@if (UserOrders is null)
{
    <div class="orders-list" aria-busy="true">
        @foreach (var _ in Enumerable.Range(0, Math.Min(PageSize, 3)))
        {
            <div class="order-card" aria-hidden="true">
                <div class="order-card-head placeholder-wave">
                    <span class="placeholder col-2"></span>
                    <span class="placeholder col-1 ms-auto"></span>
                </div>
            </div>
        }
        <span class="visually-hidden" role="status">@Loc.T("orders.loading", "Loading your orders…")</span>
    </div>
}
else if (LoadFailed)
{
    <div class="orders-empty">
        <i class="bi bi-wifi-off"></i>
        <p>@Loc.T("orders.loadfailed", "We couldn’t load your orders. Please check your connection and try again.")</p>
        <button type="button" class="btn btn-gradient" @onclick="RetryAsync">@Loc.T("checkout.retry", "Try again")</button>
    </div>
}
else if (!UserOrders.Any())
{
    <div class="orders-empty">
        <i class="bi bi-receipt"></i>
        <p>@Loc.T("orders.empty", "You have no orders yet.")</p>
        <a class="btn btn-gradient" href="/products">@Loc.T("cart.browse", "Browse products")</a>
    </div>
}
else
{
    <div class="orders-list">
        @for (int i = 0; i < UserOrders.Count; i++)
        {
            var order = UserOrders[i];
            var index = i;
            var isOpen = OpenIndex == index;
            var step = CurrentStep(order.Status);
            var itemCount = order.ProductItems?.Sum(p => p.Quantity) ?? 0;
            var bodyId = $"order-body-{i}";

            <article class="order-card @(isOpen ? "open" : "")">
                <button type="button" class="order-card-head"
                        aria-expanded="@(isOpen ? "true" : "false")" aria-controls="@bodyId"
                        @onclick="() => Toggle(index)">
                    <div class="order-ident">
                        <span class="order-id">#@order.OrderBarID</span>
                        <span class="order-date" title="@FormatIso(order.CreatedDate)">
                            @FormatDateTime(order.CreatedDate)
                            @{ var rel = FormatRelative(order.CreatedDate); }
                            @if (rel.Length > 0)
                            {
                                <span class="order-rel">&nbsp;· @rel</span>
                            }
                        </span>
                    </div>

                    @* Universal tracking colours: done = green, current = blue, upcoming = grey. *@
                    <ol class="order-steps" aria-label="@StepLabel(step)">
                        @for (int s = 0; s < StepIcons.Length; s++)
                        {
                            var state = s < step || step == StepIcons.Length - 1 ? "done" : s == step ? "current" : "pending";
                            <li class="@state">
                                <span class="step-chip">
                                    <i class="bi @(state == "done" ? "bi-check-circle-fill" : StepIcons[s])"></i>
                                    @StepLabel(s)
                                </span>
                            </li>
                        }
                    </ol>

                    <div class="order-amount">
                        <span class="order-amount-value">@InrFormat.Rupees(order.Price / 100m)</span>
                        <span class="order-amount-items">@itemCount @Loc.T("cart.itemcount", "Items")</span>
                    </div>

                    <i class="bi bi-chevron-down order-chevron"></i>
                </button>

                @if (isOpen)
                {
                    <div class="order-card-body" id="@bodyId">
                        @if (order.ProductItems is { Count: > 0 })
                        {
                            <ul class="order-items">
                                @foreach (var item in order.ProductItems)
                                {
                                    <li class="order-item">
                                        <img src="@GetItemImage(item)" alt="@item.Name" />
                                        <div class="order-item-info">
                                            <div class="order-item-name">@item.Name</div>
                                            <div class="order-item-meta">
                                                <span class="meta-chip">
                                                    <span class="meta-key">@Loc.T("orders.item.qty", "Qty:").TrimEnd(':')</span>
                                                    <strong>@item.Quantity</strong>
                                                </span>
                                                <span class="meta-chip">
                                                    <span class="meta-key">@Loc.T("orders.item.productid", "Product ID:").TrimEnd(':')</span>
                                                    <span class="meta-mono">@item.BarID</span>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="order-item-price">@InrFormat.Rupees(item.Price * item.Quantity / 100m)</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Slug))
                                        {
                                            <a class="order-item-link" href="/product/@item.Slug">
                                                @Loc.T("orders.item.view", "View") <i class="bi bi-arrow-right"></i>
                                            </a>
                                        }
                                    </li>
                                }
                            </ul>

                            <div class="order-total-row">
                                <span>@Loc.T("orders.total", "Order total")</span>
                                <span class="order-total-value">@InrFormat.Rupees(order.Price / 100m)</span>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">@Loc.T("orders.noitems", "No items in this order")</div>
                        }
                    </div>
                }
            </article>
        }
    </div>

    @if (TotalPages > 1)
    {
        <nav class="orders-pager" aria-label="@Loc.T("orders.pagination.label", "Orders page navigation")">
            @for (int i = 1; i <= TotalPages; i++)
            {
                // Show first 3 pages, last 2 pages, and 2 pages around the current one
                if (i <= 3 || i > TotalPages - 2 || (i >= CurrentPage - 1 && i <= CurrentPage + 1))
                {
                    var pageIndex = i;
                    <button type="button" class="pager-btn @(CurrentPage == pageIndex ? "active" : "")"
                            @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                }
                else if ((i == 4 && CurrentPage > 5) || (i == TotalPages - 2 && CurrentPage < TotalPages - 4))
                {
                    <span class="pager-gap">…</span>
                }
            }
        </nav>
    }
}
</div>

@code {
    private List<OrderDetail>? UserOrders;
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 10; // number of orders per page
    private long TotalPages { get; set; } = 1;

    // Only one order is open at a time; the newest starts open.
    private int OpenIndex = 0;

    private void Toggle(int index) => OpenIndex = OpenIndex == index ? -1 : index;

    private static readonly string[] StepIcons =
        ["bi-bag-check", "bi-gear", "bi-truck", "bi-truck-front", "bi-check-circle"];

    private static int CurrentStep(string? status) => status switch
    {
        "Delivered" => 4,
        "OutForDelivery" => 3,
        "Shipped" => 2,
        "ProjectCreated" or "Processing" => 1,
        _ => 0
    };

    private string StepLabel(int step) => step switch
    {
        0 => Loc.T("orders.step.ordered", "Ordered"),
        1 => Loc.T("orders.step.processing", "Processing"),
        2 => Loc.T("orders.step.shipped", "Shipped"),
        3 => Loc.T("orders.step.outfordelivery", "Out For Delivery"),
        _ => Loc.T("orders.step.delivered", "Delivered")
    };

    protected override async Task OnInitializedAsync()
    {
        Loc.OnChange += StateHasChanged;

        // Wait for MainLayout's token rehydration (see AuthReadyGate) before
        // calling the API -- on a hard refresh the saved token isn't restored yet.
        await AuthReady.Ready;

        if (!AuthenticationService.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        // Maker-only, like My Demos: everyone else goes back to their account.
        if (AuthenticationService.IsMakerAIUser != true)
        {
            Nav.NavigateTo("/account");
            return;
        }

        await LoadOrders();
    }

    // Last result per user + page, kept for the app's lifetime, so coming back
    // to My Orders shows the list at once while a fresh copy loads behind it.
    private static readonly Dictionary<string, (List<OrderDetail> Orders, long TotalPages)> Cache = new();

    private static readonly TimeSpan RequestTimeout = TimeSpan.FromSeconds(15);

    private bool LoadFailed;

    private string CacheKey => $"{AuthenticationService.UserName}|{CurrentPage}";

    private async Task RetryAsync()
    {
        LoadFailed = false;
        UserOrders = null;
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        var hadCache = Cache.TryGetValue(CacheKey, out var cached);
        if (hadCache)
        {
            UserOrders = cached.Orders;
            TotalPages = cached.TotalPages;
            StateHasChanged();
        }

        var timer = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            var request = new OrderRequest
            {
                Page = CurrentPage,
                PageSize = PageSize
            };

            // Never wait forever on the API: give up after RequestTimeout.
            var result = await MakerClient.GetAllOrdersAsync(request).WaitAsync(RequestTimeout);
            Console.WriteLine($"[Orders] GetAllOrdersAsync took {timer.ElapsedMilliseconds} ms");

            // API already returns paginated data
            UserOrders = result?.OrderDetails?.ToList() ?? [];
            TotalPages = result?.OrderDetails != null ? result.TotalPages : 1;
            Cache[CacheKey] = (UserOrders, TotalPages);
            LoadFailed = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Orders] GetAllOrdersAsync failed after {timer.ElapsedMilliseconds} ms: {ex.Message}");
            // Keep showing the cached list if there is one; otherwise say so
            // instead of pretending there are no orders.
            if (!hadCache)
            {
                LoadFailed = true;
                UserOrders = [];
            }
        }

        StateHasChanged();
    }


    private void ApplyPaging()
    {
        if (UserOrders is null) return;

        UserOrders = UserOrders
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > TotalPages)
            return;

        CurrentPage = page;
        OpenIndex = 0;
        await LoadOrders(); // Fetch data for this page
    }


    private string FormatDateTime(long milliseconds)
    {
        try
        {
            // sanity guard: 9999-12-31T00:00:00Z in ms is 253402300800000
            if (milliseconds > 0 && milliseconds < 253402300800000)
            {
                var dto = DateTimeOffset.FromUnixTimeMilliseconds(milliseconds).ToLocalTime();
                // 24h format with minutes (e.g., 18/09/2025 14:37)
                return dto.ToString("dd/MM/yyyy HH:mm");
            }
        }
        catch { }
        return Loc.T("orders.date.unknown", "Unknown");
    }

    // Prefer first non-3D asset; else any asset; else placeholder
    private string GetItemImage(ProductItem item)
    {
        if (item?.Assets is { Count: > 0 })
        {
            var img = item.Assets.FirstOrDefault(a => !a.Is3DFile && !string.IsNullOrWhiteSpace(a.Url))
                   ?? item.Assets.FirstOrDefault(a => !string.IsNullOrWhiteSpace(a.Url));
            if (!string.IsNullOrWhiteSpace(img?.Url))
                return img!.Url!;
        }
        return "/images/placeholder.png";
    }

    private string FormatIso(long ms)
    {
        try
        {
            var dto = DateTimeOffset.FromUnixTimeMilliseconds(ms).ToLocalTime();
            return dto.ToString("yyyy-MM-dd HH:mm:ss zzz");
        }
        catch { return string.Empty; }
    }

    private string FormatRelative(long ms)
    {
        try
        {
            var dt = DateTimeOffset.FromUnixTimeMilliseconds(ms).ToLocalTime();
            var delta = DateTimeOffset.Now - dt;

            if (delta.TotalSeconds < 60) return Loc.T("orders.time.justnow", "just now");
            if (delta.TotalMinutes < 60) return $"{(int)delta.TotalMinutes} {Loc.T("orders.time.minago", "min ago")}";
            if (delta.TotalHours < 24) return $"{(int)delta.TotalHours} {Loc.T("orders.time.hago", "h ago")}";
            if (delta.TotalDays < 7) return $"{(int)delta.TotalDays} {Loc.T("orders.time.dago", "d ago")}";
            // Older than a week: the full date beside it already says when.
            return "";
        }
        catch { return ""; }
    }


}
