@inherits LayoutComponentBase
@inject IAuthenticationService AuthenticationService
@inject NavigationManager Nav
@inject CartService CartService
@inject IOptions<RampEdgeSettings> MakerSettings
@inject IJSRuntime JSRuntime
@inject IMakerClient MakerClient
@inject LocalizationService Loc

<div class="page">

    <header class="site-header">

        <!-- LEFT : LOGO + NAVIGATION -->
        <NavMenu />

        <!-- RIGHT : ACTIONS -->
        <div class="header-actions">

            <!-- Search -->
            <div class="header-search">
                <Oxyniti.Pages.Inputs.SearchBox />
            </div>


            <!-- Profit Calculator — scrolls to the ROI section on this page -->
            <button class="header-icon-btn profit-btn"
                    @onclick="GoToProfitCalculator"
                    title="@Loc.T("roi.kicker", "Profit Calc")"
                    aria-label="@Loc.T("roi.kicker", "Profit Calc")">

                <i class="bi bi-graph-up-arrow"></i>

            </button>


            <!-- WhatsApp — opens the Oxyniti Network group chat; unrelated to Profit Calculator -->
            <a class="header-icon-btn whatsapp-btn"
               href="@SiteContact.WhatsAppGroupLink"
               target="_blank"
               rel="noopener"
               title="@Loc.T("nav.whatsappGroup", "Join our WhatsApp group")"
               aria-label="@Loc.T("nav.whatsappGroup", "Join our WhatsApp group")">

                <i class="bi bi-whatsapp"></i>

            </a>


            <!-- Language -->
            <div class="language-control"
                 title="@Loc.T("nav.langSelect", "Website language")">

                <span class="language-icon">
                    <i class="bi bi-globe2"></i>
                </span>

                <select id="language-select" class="language-select"
                        value="@Loc.CurrentLanguage"
                        @onchange="OnLanguageChanged"
                        aria-label="@Loc.T("nav.langSelect", "Website language")">

                    @foreach (var lang in LocalizationService.Languages)
                    {
                        <option value="@lang.Code">
                            @lang.Native
                        </option>
                    }

                </select>

                <i class="bi bi-chevron-down language-arrow"></i>

            </div>


            <!-- Cart — hidden for the duration; site doesn't need cart right now.
                 Uncomment to restore the header cart entry point.
            <a href="cart"
               class="cart-control @(HighlightCart ? "cart-highlight" : "")">

                <i class="bi bi-cart3"></i>

                <span class="cart-label">
                    @Loc.T("nav.cart", "Cart")
                </span>

                @if (CartCount > 0)
                {
                    <span class="cart-badge">
                        @CartCount
                    </span>
                }

            </a>
            -->


            <!-- User -->
            @if (AuthenticationService.IsAuthenticated)
            {
                <div class="user-dropdown">

                    <button class="user-avatar"
                            @onclick="HandleUserIconClick"
                            aria-label="User menu"
                            title="@AuthenticationService.UserName">

                        @UserInitial

                    </button>


                    @if (IsUserMenuOpen)
                    {
                        <div id="user-menu" class="user-menu">

                            <a href="/account"
                               class="user-menu-item">

                                <i class="bi bi-person-circle"></i>

                                <span>
                                    @Loc.T("menu.account", "Account")
                                </span>

                            </a>


                            @if (AuthenticationService.IsMakerAIUser == true)
                            {
                                <a @onclick="GoToMakerAIAsync"
                                   class="user-menu-item"
                                   href="#">

                                    <i class="bi bi-robot"></i>

                                    <span>
                                        @Loc.T("menu.makerai", "Go To Maker AI")
                                    </span>

                                </a>
                            }


                            <a href="/orders"
                               class="user-menu-item">

                                <i class="bi bi-receipt"></i>

                                <span>
                                    @Loc.T("menu.orders", "My Orders")
                                </span>

                            </a>


                            <a href="/my-demos"
                               class="user-menu-item">

                                <i class="bi bi-geo-alt"></i>

                                <span>
                                    @Loc.T("menu.demos", "My Demos")
                                </span>

                            </a>


                            <a href="#"
                               @onclick="Logout"
                               class="user-menu-item">

                                <i class="bi bi-box-arrow-left"></i>

                                <span>
                                    @Loc.T("menu.logout", "Logout")
                                </span>

                            </a>

                        </div>
                    }

                </div>
            }
            else
            {
                <!-- Login -->
                <a href="/login"
                   class="login-avatar"
                   title="@Loc.T("nav.login", "Login")"
                   aria-label="@Loc.T("nav.login", "Login")">

                    <i class="bi bi-person"></i>

                </a>
            }

        </div>

    </header>


    <!-- PAGE CONTENT -->
    <main>
        <article class="content">
            @Body
        </article>
    </main>

    <FloatingActionButtons />

</div>

<!-- #blazor-error-ui lives in wwwroot/index.html, created by inline script
     before blazor.webassembly.js runs, appended to document.body (outside
     this component tree). It must NOT be re-declared here: Blazor's runtime
     finds the id via a live DOM lookup regardless of which document node it
     lives on, and a second copy inside the app root created a duplicate id
     in the live DOM. -->

@code {

    // Cart count/highlight — unused while the header cart entry point is hidden.
    // private int CartCount;
    // private bool HighlightCart;

    private bool IsUserMenuOpen = false;

    private DotNetObjectReference<MainLayout>? _dotNetRef;


    private string UserInitial =>
        !string.IsNullOrWhiteSpace(AuthenticationService?.UserName)
            ? AuthenticationService.UserName[0].ToString().ToUpper()
            : "O";


    protected override async Task OnInitializedAsync()
    {
        AuthenticationService.OnChange += StateHasChanged;

        // CartService.OnChange += UpdateCartCount; // cart entry point hidden for the duration

        Loc.OnChange += StateHasChanged;

        // Captured before anything else is awaited: a locale-prefixed page
        // that isn't "ready" (LocalizedRoutes) redirects itself client-side
        // while this method is still awaiting auth/cart below, so reading
        // Nav.Uri any later can pick up the POST-redirect URL instead of the
        // one this page load actually arrived on -- which would make an
        // unrelated saved language preference override that redirect's own
        // (correct) decision to stay English.
        var entryPath = Nav.ToBaseRelativePath(Nav.Uri);


        try
        {
            await AuthenticationService.InitializeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[MainLayout] Error initializing authentication: {ex}");
        }


        try
        {
            await CartService.SyncLocalCartToServerIfNeeded();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[MainLayout] Error syncing local cart: {ex}");
        }


        try
        {
            var redirect = await Loc.InitializeAsync(entryPath);
            if (redirect is not null)
            {
                Nav.NavigateTo(redirect, replace: true);
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[MainLayout] Error initializing localization: {ex}");
        }


        // await UpdateCartCountAsync(); // feeds the header cart badge, hidden for the duration
    }


    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        var code = e.Value?.ToString();
        if (string.IsNullOrEmpty(code)) return;

        var slug = LocalizationService.StripLocalePrefix(Nav.ToBaseRelativePath(Nav.Uri));

        // A translated URL exists for this page in the chosen language (or
        // the visitor is switching back to English on one): send them there
        // -- the URL is the source of truth, issue #67 -- rather than
        // repainting in place. Everywhere else -- pages with no locale route
        // at all -- keep the pre-#67 in-place switch.
        var targetHasUrl = code == "en" || LocalizedRoutes.IsReady(slug, code);
        if (targetHasUrl && LocalizedRoutes.IsSlugLocalizable(slug))
        {
            Nav.NavigateTo(LocalizationService.BuildLocalizedPath(slug, code));
            return;
        }

        await Loc.SetLanguageAsync(code);

        try
        {
            await JSRuntime.InvokeVoidAsync("oxynitiI18n.setHtmlLang", code);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Error syncing html lang attribute: {ex}");
        }
    }


    [JSInvokable]
    public async void CloseUserMenu()
    {
        if (IsUserMenuOpen)
        {
            IsUserMenuOpen = false;

            StateHasChanged();
        }

        await JSRuntime.InvokeVoidAsync(
            "unregisterClickOutside",
            "user-menu");
    }


    private async void HandleUserIconClick()
    {
        if (!AuthenticationService.IsAuthenticated)
            return;


        if (!IsUserMenuOpen)
        {
            IsUserMenuOpen = true;

            StateHasChanged();

            await Task.Yield();


            _dotNetRef ??=
                DotNetObjectReference.Create(this);


            await JSRuntime.InvokeVoidAsync(
                "registerClickOutside",
                "user-menu",
                _dotNetRef,
                "CloseUserMenu");
        }
        else
        {
            IsUserMenuOpen = false;


            await JSRuntime.InvokeVoidAsync(
                "unregisterClickOutside",
                "user-menu");


            StateHasChanged();
        }
    }


    private async Task Logout()
    {
        try
        {
            await AuthenticationService.LogoutAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[MainLayout] Error during logout: {ex}");
        }


        try
        {
            await CartService.ClearCart();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[MainLayout] Error clearing cart: {ex}");
        }


        Nav.NavigateTo("/");
    }


    private async Task GoToProfitCalculator()
    {
        var relative =
            Nav.ToBaseRelativePath(Nav.Uri);

        var isHome =
            string.IsNullOrEmpty(relative)
            || relative.StartsWith("?");


        if (isHome)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "oxynitiScroll.toId",
                    "profit-calculator");
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    $"[MainLayout] Error scrolling to profit calculator: {ex}");
            }
        }
        else
        {
            Nav.NavigateTo(
                "/?scrollTo=profit-calculator");
        }
    }


