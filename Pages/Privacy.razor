@page "/privacy"
@implements IDisposable
@inject BusinessInfoService InfoService
@inject LocalizationService Loc

<PageTitle>Privacy Policy - Oxyniti</PageTitle>
<HeadContent>
    <link rel="canonical" href="https://www.oxyniti.com/privacy" />
</HeadContent>

<section class="cp-hero">
    <div class="cp-hero-inner">
        <span class="cp-kicker">@Loc.T("legal.kicker", "Legal")</span>
        <h1 class="cp-title">@Loc.T("privacy.title", "Privacy Policy")</h1>
        <p class="cp-lead">
            @Loc.T("privacy.lead", "How Oxyniti collects, uses and protects the information you share with us.")
        </p>
    </div>
</section>

<div class="cp-body cp-legal">
    <div class="cp-notice">
        <i class="bi bi-exclamation-circle"></i>
        <div>
            <strong>@Loc.T("legal.notice.label", "Draft document")</strong>
            <p>@string.Format(Loc.T("privacy.disclaimer", "Draft placeholder — pending final legal review and sign-off by {0} before this page is treated as binding."), InfoService.ApplicationName)</p>
        </div>
    </div>

    <div class="cp-section">
        <h2>@Loc.T("privacy.collect_title", "Information we collect")</h2>
        <p>@Loc.T("privacy.collect_body", "We collect information you provide directly (such as name, email, shipping address, and phone number during checkout or account registration) and basic usage data needed to operate the site (such as cart contents and order history).")</p>
    </div>

    <div class="cp-section">
        <h2>@Loc.T("privacy.use_title", "How we use it")</h2>
        <p>@Loc.T("privacy.use_body", "We use your information to process orders, manage your account, respond to enquiries submitted through the Contact and Quote forms, and improve the site. We do not sell your personal information to third parties.")</p>
    </div>

    <div class="cp-section">
        <h2>@Loc.T("privacy.payment_title", "Payment information")</h2>
        <p>@Loc.T("privacy.payment_body", "Payments are processed by Stripe. We do not store your full card details on our servers.")</p>
    </div>

    <div class="cp-section">
        <h2>@Loc.T("privacy.choices_title", "Your choices")</h2>
        <p>@((MarkupString)Loc.T("privacy.choices_body", "You can request access to, correction of, or deletion of your personal data by contacting us through the <a href=\"/contact\">Contact page</a>."))</p>
    </div>

    <div class="cp-links-row">
        <a href="/terms"><i class="bi bi-file-earmark-text"></i>@Loc.T("nav.terms", "Terms")</a>
        <a href="/contact"><i class="bi bi-envelope"></i>@Loc.T("nav.contact", "Contact")</a>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
        InfoService.OnChange += OnInfoChanged;
    }

    private void OnInfoChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
        InfoService.OnChange -= OnInfoChanged;
    }
}
