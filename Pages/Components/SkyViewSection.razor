@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject LocalizationService Loc

<div class="sky-view-section" id="sky-view">
    <span class="kicker">@Loc.T("sky.kicker", "See it from the sky")</span>
    <h2 class="section-title">@Loc.T("sky.h2", "Watch a pond come alive — from the sky.")</h2>
    <p class="section-lead">
        @Loc.T("sky.p", "Real footage from a live Oxyniti trial. Two units, one working pond — the milky plumes you see are pure oxygen going into solution.")
    </p>

    <div class="drone-stage">
        <picture class="drone-poster" aria-hidden="true">
            <source media="(max-width: 640px)" type="image/webp" srcset="/images/drone-hero-v2-poster-mobile.webp" />
            <source media="(max-width: 640px)" type="image/jpeg" srcset="/images/drone-hero-v2-poster-mobile.jpg" />
            <source type="image/webp" srcset="/images/drone-hero-v2-poster-desktop.webp" />
            <img @ref="_posterElement"
                 src="/images/drone-hero-v2-poster-desktop.jpg"
                 width="1600"
                 height="640"
                 loading="lazy"
                 decoding="async"
                 fetchpriority="low"
                 alt="" />
        </picture>

        <video @ref="_videoElement"
               muted
               loop
               playsinline
               preload="none"
               aria-hidden="true">
            <source media="(max-width: 640px)" data-src="/videos/drone-hero-v2-mobile-av1.webm" type="video/webm; codecs=av01.0.04M.08" />
            <source media="(max-width: 640px)" data-src="/videos/drone-hero-v2-mobile-vp9.webm" type="video/webm; codecs=vp9" />
            <source media="(max-width: 640px)" data-src="/videos/drone-hero-v2-mobile.mp4" type="video/mp4; codecs=avc1.64001F" />
            <source media="(min-width: 641px)" data-src="/videos/drone-hero-v2-desktop-av1.webm" type="video/webm; codecs=av01.0.05M.08" />
            <source media="(min-width: 641px)" data-src="/videos/drone-hero-v2-desktop-vp9.webm" type="video/webm; codecs=vp9" />
            <source media="(min-width: 641px)" data-src="/videos/drone-hero-v2-desktop.mp4" type="video/mp4; codecs=avc1.640029" />
        </video>

        <div class="rec-badge"><i></i><span>@Loc.T("sky.rec", "DRONE · LIVE TRIAL")</span></div>
        <div class="hud-chips">
            <div class="hud-chip"><span class="dot"></span>@Loc.T("sky.c1", "Unit 1 · nano-plume active")</div>
            <div class="hud-chip"><span class="dot"></span>@Loc.T("sky.c2", "DO rising across pond")</div>
            <div class="hud-chip"><span class="dot"></span>@Loc.T("sky.c3", "Field trial · South India")</div>
        </div>
    </div>
</div>

@code {
    private ElementReference _videoElement;
    private ElementReference _posterElement;
    private IJSObjectReference? _videoModule;
    private IJSObjectReference? _videoController;

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _videoModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/lazyBackgroundVideo.js");

            _videoController = await _videoModule.InvokeAsync<IJSObjectReference>(
                "init",
                _videoElement,
                _posterElement,
                new
                {
                    eager = false,
                    respectNarrowViewport = false,
                    deferUntilPosterPaint = true,
                    rootMargin = "800px 0px",
                    pauseWhenHidden = true
                });
        }
        catch (JSException)
        {
            // Prevent page from breaking if JS is unavailable.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Loc.OnChange -= StateHasChanged;

        try
        {
            if (_videoController is not null)
            {
                await _videoController.InvokeVoidAsync("dispose");
                await _videoController.DisposeAsync();
            }

            if (_videoModule is not null)
            {
                await _videoModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Safe to ignore when Blazor circuit disconnects.
        }
    }
}
