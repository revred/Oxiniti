@inject BusinessInfoService InfoService

@if (!_loaded)
{
    <div>Loading...</div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment ChildContent { get; set; } = default!;
    bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await InfoService.LoadAsync();
        }
        catch (Exception ex)
        {
            // Business info (branding/testimonials/etc.) is a nice-to-have from an external CMS —
            // the whole site must not go down just because that one call failed.
            Console.WriteLine($"[BusinessInfoLoader] Failed to load business info: {ex}");
        }
        finally
        {
            _loaded = true;
        }
    }
}
