@inject LocalizationService Loc

@* No title= on these buttons: each has its own .floating-tooltip label on
   hover, and a title added the browser's tooltip on top of it -- the same
   words shown twice. aria-label still names them for screen readers. *@
<div class="floating-actions">

    <a class="floating-btn floating-btn-profit"
       href="/yield-calculator"
       aria-label="@Loc.T("nav.calc", "Yield Calculator")">

        <i class="bi bi-graph-up-arrow"></i>
        <span class="floating-tooltip">@Loc.T("nav.calc", "Yield Calculator")</span>

    </a>

    <a class="floating-btn floating-btn-whatsapp"
       href="@SiteContact.WhatsAppLink()"
       target="_blank"
       rel="noopener"
       aria-label="@Loc.T("nav.whatsapp", "Chat with us on WhatsApp")">

        <i class="bi bi-whatsapp"></i>
        <span class="floating-tooltip">@Loc.T("nav.whatsapp", "Chat on WhatsApp")</span>

    </a>

</div>

@code {
    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }
}
