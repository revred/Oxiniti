@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject LocalizationService Loc

<div class="hero-container">
    <img @ref="_posterElement" class="hero-poster" src="/images/hero-poster-wide.avif" width="1280" height="720"
         fetchpriority="high" decoding="async" alt="" />
    <video @ref="_videoElement" class="hero-video" muted loop playsinline poster="/images/hero-poster-wide.jpg"
           data-video-init="lazy-eager">
        <source data-src="/videos/hero.webm" type="video/webm" />
        <source data-src="/videos/hero.mp4" type="video/mp4" />
    </video>
    <div class="gradient-overlay"></div>

    <div class="hero-content">
        <span class="hero-kicker">@Loc.T("hero.kicker", "Namaskar, Fish Farmers! 🐟")</span>
        <h1 class="hero-title">@((MarkupString)Loc.T("hero.title", "Infinite Oxygen.<br />Infinite Yield."))</h1>
        <p class="hero-sub">
            @Loc.T("hero.sub", "Oxyniti's nano-bubble generator floods your pond with trillions of invisible oxygen bubbles that stay dissolved for days — not seconds. Healthier fish, faster growth, bigger harvests.")
        </p>
        <div class="hero-ctas">
            <a href="#free-demo" class="btn btn-explore">@Loc.T("hero.cta1", "Book a Free Pond Demo")</a>
            <a href="#sky-view" class="btn btn-ghost">@Loc.T("hero.cta2", "▶  Watch it work")</a>
        </div>
        <div class="hero-stats">
            <div class="hero-stat">
                <div class="num">2&times;</div>
                <div class="lbl">@Loc.T("hero.s1l", "More dissolved oxygen*")</div>
            </div>
            <div class="hero-stat">
                <div class="num">&lt;200nm</div>
                <div class="lbl">@Loc.T("hero.s2l", "Bubble size — stays for days")</div>
            </div>
            <div class="hero-stat">
                <div class="num">@Loc.T("hero.s3n", "1 Day")</div>
                <div class="lbl">@Loc.T("hero.s3l", "Install — fits any pond")</div>
            </div>
        </div>
    </div>
</div>

@code {
    private ElementReference _videoElement;
    private ElementReference _posterElement;
    private IJSObjectReference? _videoModule;
    private IJSObjectReference? _videoController;

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _videoModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/lazyBackgroundVideo.js");

            _videoController = await _videoModule.InvokeAsync<IJSObjectReference>(
                "init",
                _videoElement,
                _posterElement,
                new { eager = true, respectNarrowViewport = false, deferUntilPosterPaint = true });
        }
        catch (JSException)
        {
            // Prevent page from breaking if JS is unavailable.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Loc.OnChange -= StateHasChanged;

        try
        {
            if (_videoController is not null)
            {
                await _videoController.InvokeVoidAsync("dispose");
                await _videoController.DisposeAsync();
            }

            if (_videoModule is not null)
            {
                await _videoModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Safe to ignore when Blazor circuit disconnects.
        }
    }
}
