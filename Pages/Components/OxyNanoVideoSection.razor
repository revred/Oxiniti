@inject LocalizationService Loc
@implements IDisposable

<section class="oxy-video-section" id="oxy-nano-video" aria-labelledby="oxy-video-title">

    @* Rising nano-bubbles, drawn in CSS only -- nothing to download. *@
    <div class="oxy-bubbles" aria-hidden="true">
        @for (var i = 0; i < 10; i++)
        {
            <span></span>
        }
    </div>

    <div class="oxy-video-inner">

        <span class="oxy-video-kicker">
            <span class="oxy-kicker-dot" aria-hidden="true"></span>
            @Loc.T("oxyNano.kicker", "OXY-NANO SERIES")
        </span>

        <h2 id="oxy-video-title">
            @Loc.T(
                "oxyNano.title",
                "See the OXY-Nano Series in action."
            )
        </h2>

        <p>
            @Loc.T(
                "oxyNano.description",
                "From low-oxygen ponds to bigger harvests: see how OXY-Nano nano-bubbles reach the whole pond floor, the 1.5, 3 and 5 HP models, and the yield gains farmers are seeing."
            )
        </p>

        @*
            The product overview lives on YouTube rather than being streamed
            from the homepage -- same reasoning as the drone clip in
            SkyViewSection: no video download for visitors who scroll past.
            data-yt-embed plays it in a popup on the page (js/videoLightbox.js);
            the href is the fallback for ctrl/middle clicks.
        *@
        <a class="oxy-video-cta"
           href="@YouTubeUrl"
           data-yt-embed="@YouTubeId"
           target="_blank"
           rel="noopener noreferrer">
            <span class="play-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M8 5.5v13l11-6.5z" />
                </svg>
            </span>
            <span>@Loc.T("video.watch", "Watch video")</span>
        </a>

    </div>

</section>


@code {
    /// <summary>The OXY-Nano Series product overview on the Oxyniti YouTube channel.</summary>
    private const string YouTubeId = "wRUlzXs4LWs";
    private const string YouTubeUrl = "https://www.youtube.com/watch?v=" + YouTubeId;

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }
}
